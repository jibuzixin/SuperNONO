  "rules": {
    "动作": "动画 gotoAndPlay(0) 之后立刻 _sound.play(0, souLoops)；souLoops 来自配置表 <action> 段（充电 999999 = 无限循环，其余 1）",
    "表情": "动画 gotoAndPlay(0) 之后立刻 _sound.play(0, 1)（配置表 <exp> 段没有 souLoops）",
    "走路": "无音效",
    "停止": "下一个动作/表情开始前 clearActionMC() 里 _sc.stop()",
    "Sound来源": "动作 SWF 内嵌的 sou 类，宿主把它作为 param1[1] 传给模型",
    "autoEnd（管动画，不管声音）": "autoEnd=0（充电、关机）：末帧不派发 PLAY_COMPLETE、不切回走路，动作停在末帧；autoEnd=1（其余 5 个）：末帧派发完成事件并切回走路。**所有动作的动画都是 loop:false** —— autoEnd=0 不等于循环播放。"
  }
